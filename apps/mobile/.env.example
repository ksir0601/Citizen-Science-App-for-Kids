# Copy this file to .env.local (git-ignored) and fill in the values.
# Restart Expo after any change: npx expo start --clear
# Use the publishable key, never the secret key.
# Local Supabase on a real phone: use your computer's Wi-Fi IP, not 127.0.0.1
#   e.g. http://192.168.1.23:54321   Android emulator: http://10.0.2.2:54321

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

